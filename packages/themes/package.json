{
  "name": "@northern.tech/themes",
  "version": "0.18.2",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorthernTechHQ/nt-gui.git"
  },
  "exports": {
    "./Mender": {
      "types": "./dist/Mender/index.d.ts",
      "import": "./dist/Mender/index.js"
    },
    "./Mender/styles/main.css": {
      "default": "./dist/style.css"
    },
    "./Alvaldi": {
      "types": "./dist/Alvaldi/index.d.ts",
      "import": "./dist/Alvaldi/index.js"
    },
    "./CFEngine": {
      "types": "./dist/CFEngine/index.d.ts",
      "import": "./dist/CFEngine/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --onSuccess 'yalc publish --no-script --push'",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "yalc:publish": "yalc publish --no-script --push"
  },
  "type": "module",
  "sideEffects": false,
  "devDependencies": {
    "@northern.tech/eslint-config": "*",
    "@northern.tech/typescript-config": "*",
    "@tsdown/css": "^0.23.0",
    "@types/node": "26.6.5",
    "eslint": "^10.8.0",
    "less": "^4.8.1",
    "tsdown": "^0.23.0"
  },
  "dependencies": {
    "@mui/material": "^9.x"
  }
}
