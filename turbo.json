{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "@northern.tech/common#build": {
      "dependsOn": ["^build", "@northern.tech/common-ui#build", "@northern.tech/store#build", "@northern.tech/themes#build", "@northern.tech/utils#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@northern.tech/common-ui#build": {
      "dependsOn": ["^build", "@northern.tech/store#build", "@northern.tech/utils#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@northern.tech/store#build": {
      "dependsOn": ["^build", "@northern.tech/types#build", "@northern.tech/utils#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@northern.tech/testing#build": {
      "dependsOn": ["^build", "@northern.tech/utils#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@northern.tech/utils#build": {
      "dependsOn": ["^build", "@northern.tech/types#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "cache": true
    },
    "format:check": {
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test-ci": {
      "cache": true,
      "dependsOn": ["^@northern.tech/testing#build"]
    },
    "@northern.tech/common-ui#test-ci": {
      "dependsOn": ["@northern.tech/store#build", "@northern.tech/store#test-ci"]
    },
    "@northern.tech/common#test-ci": {
      "dependsOn": ["@northern.tech/common-ui#build", "@northern.tech/common-ui#test-ci"]
    },
    "clean": {
      "cache": false
    },
    "yalc:publish": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
